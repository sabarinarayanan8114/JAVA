class Solution {
    public String addStrings(String num1, String num2) {
        int sum = 0;
        int carry = 0;
        StringBuilder res = new StringBuilder();

        int i = num1.length() - 1;
        int j = num2.length() - 1;
        while(i >= 0 || j >= 0){
            sum = carry;

            if(i >= 0){
                int num1LastDigit = num1.charAt(i) - '0';
                sum += num1LastDigit;
                i--;
            }
            
            if(j >= 0){
                int num2LastDigit = num2.charAt(j) - '0';
                sum += num2LastDigit;
                j--;
            }
            res.append(sum % 10);
            carry = sum / 10;
        }

        if(carry > 0) res.append(carry);

        return res.reverse().toString();
    }
}
